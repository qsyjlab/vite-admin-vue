{
  "name": "vite-admin-vue",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "qsyjlab"
  },
  "scripts": {
    "dev": "vite --host",
    "app:prod": "vite --host --mode prod",
    "build": "vite build",
    "build:packages": "pnpm --filter @framebase/element-plus-pro-components --filter @framebase/vue-code-editor --filter @framebase/element-plus-theme build",
    "build:prod": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vite build --mode prod",
    "test": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:pro": "pnpm run test:types && pnpm run test:unit && pnpm run test:e2e",
    "test:types": "vue-tsc -p tsconfig.type-tests.json --noEmit",
    "test:unit": "vitest run",
    "test:packages": "pnpm --filter @framebase/element-plus-pro-components --filter @framebase/vue-code-editor --filter @framebase/element-plus-theme test",
    "test:consumer": "pnpm pack:packages && node --import tsx ./build/scripts/verify-package-consumer.ts",
    "check": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vue-tsc -b --noEmit",
    "check:packages": "pnpm --filter @framebase/element-plus-pro-components --filter @framebase/vue-code-editor --filter @framebase/element-plus-theme typecheck",
    "lint:packages": "pnpm --filter @framebase/element-plus-pro-components --filter @framebase/vue-code-editor --filter @framebase/element-plus-theme lint",
    "audit:packages": "node --import tsx ./build/scripts/audit-package-boundaries.ts",
    "verify:package-artifacts": "node --import tsx ./build/scripts/verify-package-artifacts.ts",
    "verify:release": "pnpm verify:packages && pnpm test:consumer",
    "pack:packages": "pnpm --filter @framebase/element-plus-pro-components --filter @framebase/vue-code-editor --filter @framebase/element-plus-theme pack:check",
    "verify:packages": "pnpm audit:packages && pnpm check:packages && pnpm lint:packages && pnpm test:packages && pnpm build:packages && pnpm verify:package-artifacts",
    "preview": "vite preview",
    "prettier": "prettier --write .",
    "lint": "eslint . --fix",
    "prepare": "husky install",
    "clean:lib": "rimraf node_modules",
    "clean:output": "rimraf .output",
    "buildComponents": "node ./build/scripts/buildComponents.ts",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release:publish": "pnpm verify:release && changeset publish"
  },
  "repository": {
    "url": "https://github.com/qsyjlab/vite-admin-vue"
  },
  "engines": {
    "node": ">= 20.19",
    "pnpm": ">=10 <11"
  },
  "dependencies": {
    "@arco-design/color": "^0.4.0",
    "@element-plus/icons-vue": "^2.3.1",
    "@framebase/element-plus-pro-components": "workspace:*",
    "@framebase/element-plus-theme": "workspace:*",
    "@framebase/vue-code-editor": "workspace:*",
    "@unocss/reset": "^0.58.3",
    "@vue-office/excel": "^1.7.1",
    "@vue-office/pdf": "^1.6.4",
    "@vueuse/core": "^10.7.2",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "docx": "^8.5.0",
    "docx-preview": "^0.3.0",
    "echarts": "^5.4.3",
    "element-plus": "^2.9.7",
    "html2canvas": "^1.4.1",
    "jsencrypt": "^3.3.2",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.1",
    "print-js": "^1.6.0",
    "qiankun": "^2.10.16",
    "qrcode": "^1.5.3",
    "sortablejs": "^1.15.0",
    "tinymce": "5.10.9",
    "vite-plugin-qiankun": "^1.0.15",
    "vue": "^3.5.13",
    "vue-component-type-helpers": "^2.1.6",
    "vue-demi": "^0.14.7",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^17.0.3",
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.61.1",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.1",
    "@types/nprogress": "^0.2.0",
    "@types/qrcode": "^1.5.1",
    "@types/sortablejs": "^1.15.3",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "@vitest/ui": "^1.5.0",
    "@vue/compiler-dom": "3.5.13",
    "@vue/compiler-sfc": "3.5.13",
    "@vue/server-renderer": "3.5.13",
    "@vue/tsconfig": "^0.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "husky": "^7.0.4",
    "lint-staged": "^15.5.1",
    "msw": "^2.15.0",
    "postcss": "^8.4.16",
    "postcss-preset-env": "^7.8.0",
    "prettier": "^3.5.3",
    "rimraf": "^3.0.2",
    "rollup-plugin-visualizer": "^5.9.2",
    "sass": "^1.86.3",
    "terser": "^5.43.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "unocss": "^66.3.3",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-element-plus": "^0.8.0",
    "unplugin-vue-components": "^28.4.1",
    "vite": "8.0.0",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^1.5.0",
    "vue-tsc": "^3.2.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
