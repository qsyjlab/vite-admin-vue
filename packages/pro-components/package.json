{
  "name": "@framebase/element-plus-pro-components",
  "version": "0.1.0",
  "description": "Vue 3 and Element Plus Pro components for forms, tables and data-heavy interfaces.",
  "license": "MIT",
  "author": "qsyjlab",
  "repository": {
    "type": "git",
    "url": "https://github.com/qsyjlab/vite-admin-vue.git",
    "directory": "packages/pro-components"
  },
  "bugs": {
    "url": "https://github.com/qsyjlab/vite-admin-vue/issues"
  },
  "homepage": "https://github.com/qsyjlab/vite-admin-vue/tree/master/packages/pro-components",
  "keywords": [
    "vue",
    "vue3",
    "element-plus",
    "pro-components",
    "form",
    "table"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js"
    },
    "./style.css": "./dist/es/style.css",
    "./*": {
      "types": "./dist/types/*/index.d.ts",
      "import": "./dist/es/*/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && pnpm run build:types && vite build --config vite.config.ts",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "lint": "eslint src",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "pack:check": "pnpm run verify && pnpm pack --pack-destination ../../.output/packages",
    "prepublishOnly": "pnpm run verify"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "dayjs": "^1.11.0",
    "element-plus": "^2.9.0",
    "lodash-es": "^4.17.0",
    "sortablejs": "^1.15.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {}
}
