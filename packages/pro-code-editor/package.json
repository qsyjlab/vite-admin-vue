{
  "name": "@framebase/vue-code-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js"
    },
    "./style.css": "./dist/es/style.css",
    "./*": {
      "types": "./dist/types/*/index.d.ts",
      "import": "./dist/es/*/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && pnpm run build:types && vite build --config vite.config.ts",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "lint": "eslint src",
    "pack:check": "pnpm run build && pnpm pack --pack-destination ../../.output/packages"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
